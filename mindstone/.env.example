# Copy to .env (gitignored) and fill in. Generate the four secrets with:
#   for k in CREDS_KEY JWT_SECRET JWT_REFRESH_SECRET; do echo "$k=$(openssl rand -hex 32)"; done; echo "CREDS_IV=$(openssl rand -hex 16)"
APP_TITLE=MindStone Console
CREDS_KEY=
CREDS_IV=
JWT_SECRET=
JWT_REFRESH_SECRET=
# The MindStone-Agent gateway: start it with chat completions enabled and token auth.
MINDSTONE_GATEWAY_URL=http://host.docker.internal:19790/v1
MINDSTONE_GATEWAY_TOKEN=
# The first account registered becomes the admin. Set to false after that.
ALLOW_REGISTRATION=true
ALLOW_SOCIAL_LOGIN=false
