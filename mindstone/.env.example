# Copy to .env (gitignored) and fill in. Generate the four secrets with:
#   for k in CREDS_KEY JWT_SECRET JWT_REFRESH_SECRET; do echo "$k=$(openssl rand -hex 32)"; done; echo "CREDS_IV=$(openssl rand -hex 16)"
APP_TITLE=MindStone Console
# Keeps the credit to LibreChat (MIT), which the Console is built on.
CUSTOM_FOOTER="MindStone Console, built on [LibreChat](https://librechat.ai)"
CREDS_KEY=
CREDS_IV=
JWT_SECRET=
JWT_REFRESH_SECRET=
# The MindStone-Agent gateway: start it with chat completions enabled and token auth.
MINDSTONE_GATEWAY_URL=http://host.docker.internal:19790/v1
MINDSTONE_GATEWAY_TOKEN=
# The gateway's admin credential, for the settings page. Generate one (openssl rand -hex 32) and
# put it here. On the gateway, set gateway.admin.tokenSha256 to its digest
# (printf %s "<token>" | shasum -a 256), so the gateway never holds the credential itself.
# Without it the gateway has no admin API.
MINDSTONE_ADMIN_TOKEN=
# Off: anyone who can reach the page could register, and the first account
# becomes the admin. Create accounts with `npm run create-user` (see MINDSTONE.md).
ALLOW_REGISTRATION=false
ALLOW_SOCIAL_LOGIN=false
